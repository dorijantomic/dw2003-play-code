{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["web/**/*.ts", "web/**/*.mts"],
  "exclude": ["web/lib3d", "web/vendor", "web/assets", "web/assets-hd", "web/assets-lab", "web/**/node_modules"]
}
