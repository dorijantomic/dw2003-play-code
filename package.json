{
  "name": "ddw3-walker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/*.test.js' 'tests/lane-b/*.test.js'",
    "test:translations": "node tools/test_translations.mjs",
    "test:engine": "node --test 'tests/engine/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build:engine": "node tools/build_engine_bundles.mjs",
    "build:content": "node tools/engine-convert/convert.ts",
    "autopilot": "node tools/story_autopilot.ts",
    "setup:playwright": "playwright install chromium-headless-shell",
    "postinstall": "playwright install chromium-headless-shell || true",
    "pw": "tools/run-playwright.sh",
    "verify:opening": "tools/run-playwright.sh tools/verify_opening_flow.mjs",
    "verify:launchpad": "tools/run-playwright.sh tools/verify_launch_pad.mjs",
    "verify:fire-trap": "tools/run-playwright.sh tools/verify_fire_trap.mjs",
    "verify:ambush": "tools/run-playwright.sh tools/verify_ambush_tile.mjs",
    "verify:talk-event": "tools/run-playwright.sh tools/verify_talk_event.mjs",
    "verify:entry-key": "tools/run-playwright.sh tools/verify_entry_key.mjs",
    "verify:encounters": "tools/run-playwright.sh tools/verify_encounter_rate.mjs",
    "verify:s415": "tools/run-playwright.sh tools/verify_s415.mjs",
    "verify:music-remaster": "tools/run-playwright.sh tools/verify_music_remaster_lab.mjs",
    "verify:music-hd": "tools/run-playwright.sh tools/verify_music_hd_lab.mjs",
    "verify:asuka-hooks": "tools/run-playwright.sh tools/verify_asuka_hook_lab.mjs",
    "verify:alias-world": "tools/run-playwright.sh tools/verify_alias_world.mjs",
    "verify:field-shadow": "tools/run-playwright.sh tools/verify_field_shadow.mjs",
    "verify:ladder-shadow": "tools/run-playwright.sh tools/verify_ladder_shadow.mjs",
    "verify:tree-kick": "tools/run-playwright.sh tools/verify_tree_kick.mjs",
    "verify:submarimon": "tools/run-playwright.sh tools/verify_submarimon_controls.mjs",
    "verify:arena": "tools/run-playwright.sh tools/verify_arena_finale.mjs",
    "verify:blast": "tools/run-playwright.sh tools/verify_blast.mjs",
    "verify:blast-revert": "SCREEN=revert tools/run-playwright.sh tools/verify_blast.mjs",
    "verify:manual-dv": "SCREEN=manualdv tools/run-playwright.sh tools/verify_blast.mjs",
    "verify:camera-snap": "tools/run-playwright.sh tools/verify_camera_snap.mjs",
    "verify:seam-lab": "tools/run-playwright.sh tools/verify_seam_lab.mjs",
    "verify:battle-cues": "tools/run-playwright.sh tools/verify_battle_cues.mjs",
    "verify:journey": "tools/run-playwright.sh tools/verify_journey.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
